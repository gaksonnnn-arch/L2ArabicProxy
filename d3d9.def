;
; الغرض:
;   هذا الملف يعرّف الدوال المُصدَّرة (Exports) من مكتبة البروكسي d3d9.dll
;   ويضمن تطابق أسماء الدوال ورتبها (Ordinals) مع مكتبة d3d9.dll الأصلية
;   الموجودة في C:\Windows\System32\d3d9.dll
;
; كيف يعمل البروكسي:
;   عندما تُحمّل اللعبة d3d9.dll (نسختنا)، تستدعي إحدى الدوال التالية.
;   نحن نعترض الاستدعاء ونمرره إلى المكتبة الأصلية بعد تنفيذ إضافاتنا
;   (مثل تعريب الشات العربي وترجمة نصوص الواجهات).
;
; ملاحظات حرجة:
;   1. قيم الـ Ordinals (@1, @2 ...) يجب أن تطابق d3d9.dll الأصلية 100%،
;      لأن بعض البرامج تستدعي الدوال بالـ Ordinal وليس بالاسم.
;   2. اسم المكتبة (LIBRARY d3d9) يعني أن الملف الناتج يجب أن يكون
;      d3d9.dll بالضبط، وإلا لن تتعرف عليه اللعبة.
;   3. الترتيب هنا مطابق لـ Windows 7/8/10/11.
; ============================================================================

LIBRARY d3d9

EXPORTS

    ; ========================================================================
    ; [القسم 1] دوال إنشاء كائن Direct3D الأساسية
    ; ========================================================================
    ; هذه هي الدوال الرئيسية التي تستدعيها اللعبة عادةً. بدونها لا تعمل
    ; الرسوميات ثلاثية الأبعاد إطلاقاً. نعترضها لإظهار نافذة الترحيب
    ; وتثبيت هوكات التعريب.
    ; ------------------------------------------------------------------------

    Direct3DCreate9                  = Direct3DCreate9_Proxy              @1
    Direct3DCreate9Ex                = Direct3DCreate9Ex_Proxy            @2


    ; ========================================================================
    ; [القسم 2] دوال التحقق من Shader و PSGP (Pixel Shader Generation Pipeline)
    ; ========================================================================
    ; دوال داخلية يستخدمها محرك D3D9 لتحسين الأداء على بطاقات الرسوميات.
    ; نمررها مباشرة للمكتبة الأصلية بدون تدخل.
    ; ------------------------------------------------------------------------

    Direct3DShaderValidatorCreate9   = Direct3DShaderValidatorCreate9_Proxy @3
    PSGPError                        = PSGPError_Proxy                    @4
    PSGPSampleTexture                = PSGPSampleTexture_Proxy            @5


    ; ========================================================================
    ; [القسم 3] دوال قياس الأداء D3DPERF (Performance Profiling)
    ; ========================================================================
    ; تستخدمها أدوات Profiling وتطبيقات DirectX SDK. تمرير سلبي.
    ; ------------------------------------------------------------------------

    D3DPERF_BeginEvent               = D3DPERF_BeginEvent_Proxy           @6
    D3DPERF_EndEvent                 = D3DPERF_EndEvent_Proxy             @7
    D3DPERF_GetStatus                = D3DPERF_GetStatus_Proxy            @8
    D3DPERF_QueryRepeatFrame         = D3DPERF_QueryRepeatFrame_Proxy     @9
    D3DPERF_SetMarker                = D3DPERF_SetMarker_Proxy            @10
    D3DPERF_SetOptions               = D3DPERF_SetOptions_Proxy           @11
    D3DPERF_SetRegion                = D3DPERF_SetRegion_Proxy            @12


    ; ========================================================================
    ; [القسم 4] دوال التصحيح (Debugging)
    ; ========================================================================
    ; دوال موجودة في إصدارات Debug من d3d9. نصدّرها للتوافق الكامل.
    ; ------------------------------------------------------------------------

    DebugSetLevel                    = DebugSetLevel_Proxy                @13
    DebugSetMute                     = DebugSetMute_Proxy                 @14


; ============================================================================
; ملاحظات إضافية:
; ============================================================================
;
; 1) لماذا لا نستخدم __declspec(dllexport) في الكود؟
;    لأن d3d9.dll يحتوي على دوال مصدَّرة بـ Ordinals محددة، والـ .def
;    يضمن أن Ordinal كل دالة يطابق تماماً ما تتوقعه البرامج.
;
; 2) هل يمكن إضافة دوال جديدة؟
;    لا. أي دالة غير موجودة في d3d9.dll الأصلي لن تُقبل من قبل النظام.
;
; 3) كيف يتم التحقق من صحة الـ .def؟
;    افتح CMD واكتب:
;      dumpbin /exports C:\Windows\System32\d3d9.dll
;    قارن الأرقام في العمود الأول مع ما هو موجود هنا.
;
; 4) لتشغيل البروكسي كـ d3d9.dll، انسخ الملف الناتج إلى مجلد اللعبة
;    بجانب L2.exe أو L2Client.exe.
;
; ============================================================================
; نهاية الملف
; ============================================================================